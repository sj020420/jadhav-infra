PORT=5001
# Neon (or any PostgreSQL) connection string. Must end with ?sslmode=require for Neon.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Frontend URL(s) allowed to call this API (comma separated, no trailing slash). Leave empty locally.
FRONTEND_URL=https://your-app.vercel.app

# ---- Login ----
ADMIN_USERNAME=aj1818
# Type your password here in your OWN backend/.env (never commit it). On Render, set it in the dashboard.
ADMIN_PASSWORD=
# Any long random text (Render generates it automatically). Locally you may leave it empty.
JWT_SECRET=
